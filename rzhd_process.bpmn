      <bpmn:errorEventDefinition id="ErrorEventDefinition_Form_ServiceRequestValidationFailed" errorRef="Error_ValidationFailed" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_Form_CardValidationFailed" name="Ошибка формы" attachedToRef="Task_Client_EnterCard">
