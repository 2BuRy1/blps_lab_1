      <bpmn:outgoing>Flow_0pl2o3o</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Client_Success" name="Покупка завершена">
      <bpmn:incoming>Flow_0pl2o3o</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Client_ConfirmOrder" name="Подтвердить заказ" camunda:formKey="camunda-forms:app:forms/client-confirm-order.form" camunda:candidateGroups="client">
      <bpmn:extensionElements>
