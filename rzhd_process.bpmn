    <bpmn:participant id="Participant_Bank" name="Банк (ROLE=SERVICE_BANK)" processRef="Process_Bank" />
    <bpmn:participant id="Participant_0zmpeqw" name="Служебные Операции (ADMIN)" processRef="Process_1ah8gm5" />
    <bpmn:messageFlow id="Flow_0erw54r" sourceRef="Task_Client_ConfirmOrder" targetRef="Activity_0tq7mhk" />
    <bpmn:messageFlow id="Flow_0vn9tg3" sourceRef="Task_Server_CreateBooking" targetRef="Task_Client_EnterCard" />
    <bpmn:messageFlow id="MF_Client_ServerPayInit" sourceRef="Task_Client_EnterCard" targetRef="Activity_0q552ql" />
    <bpmn:messageFlow id="MF_Server_Bank3DSConfirm" sourceRef="Task_Server_Confirm3DSWithBank" targetRef="Activity_0be6dun" />
    <bpmn:messageFlow id="MF_Client_Server3DSConfirm" sourceRef="Task_Client_Confirm3DS" targetRef="Task_Server_Confirm3DSWithBank" />
    <bpmn:messageFlow id="MF_Server_Client3DSChallenge" sourceRef="Task_Server_Send3DSChallengeToClient" targetRef="Task_Client_Confirm3DS" />
    <bpmn:messageFlow id="Flow_02lw6hn" sourceRef="Activity_05s562c" targetRef="Activity_1xciu8s" />
    <bpmn:messageFlow id="Flow_167ul0q" sourceRef="Task_Server_SendPaymentToBank" targetRef="Task_Bank_Authorize" />
    <bpmn:messageFlow id="Flow_02oem81" sourceRef="Task_Operator_SubmitServiceRequest" targetRef="Activity_1fonyhw" />
    <bpmn:messageFlow id="Flow_1t2jrgu" sourceRef="Activity_0zr7z9q" targetRef="Activity_0nq613n" />
    <bpmn:messageFlow id="Flow_0dvip8v" sourceRef="Activity_07doqq4" targetRef="Task_Server_UpdatePaymentStatusDB" />
    <bpmn:messageFlow id="Flow_08u24dl" sourceRef="Activity_0wv29qh" targetRef="Task_Server_UpdatePaymentStatusDB" />
    <bpmn:messageFlow id="Flow_19xaxaa" sourceRef="Activity_1hr4b4m" targetRef="Activity_1vxh5lh" />
    <bpmn:messageFlow id="Flow_1aau246" sourceRef="CallActivity_Server_ServiceOperations" targetRef="Activity_0kywx0m" />
    <bpmn:messageFlow id="Flow_1j3pw83" sourceRef="Task_Bank_Send3DSRequired" targetRef="Event_0bqm1oq" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Client" name="Клиент: покупка в ЛК" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:laneSet id="LaneSet_Process_Client">
      <bpmn:lane id="Lane_Client_RoleOperatorAdmin" name="ROLE: OPERATOR/ADMIN">
