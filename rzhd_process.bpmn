        <bpmn:outgoing>Flow_1n58psq</bpmn:outgoing>
        <bpmn:outgoing>Flow_Transaction_Wait3dsConfirm</bpmn:outgoing>
        <bpmn:outgoing>Flow_Transaction_Cancel</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="Task_Server_Confirm3DSWithBank" name="Передать подтверждение 3DS в банк" camunda:formKey="camunda-forms:app:forms/confirm-3ds.form" camunda:candidateGroups="client,admin,operator">
        <bpmn:extensionElements>
          <camunda:taskListener delegateExpression="${formDataValidator}" event="complete" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_Transaction_Wait3dsConfirm</bpmn:incoming>
        <bpmn:incoming>Flow_Form_Server3dsValidationFailed</bpmn:incoming>
        <bpmn:outgoing>Flow_Transaction_Confirm3dsDispatch</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:boundaryEvent id="Boundary_Form_Server3dsValidationFailed" name="Ошибка формы" attachedToRef="Task_Server_Confirm3DSWithBank">
        <bpmn:outgoing>Flow_Form_Server3dsValidationFailed</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_Form_Server3dsValidationFailed" errorRef="Error_ValidationFailed" />
      </bpmn:boundaryEvent>
      <bpmn:boundaryEvent id="Boundary_Server_Pending3dsTtl" attachedToRef="Task_Server_Confirm3DSWithBank">
        <bpmn:outgoing>Flow_Transaction_CancelPending3dsByTtl</bpmn:outgoing>
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration>${pending3dsTtlIso}</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:serviceTask id="Task_Server_CancelPending3dsTtl" name="Отменить заказ по TTL PENDING_3DS" camunda:delegateExpression="${cancelPending3dsByTtlDelegate}">
