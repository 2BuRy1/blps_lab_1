      <bpmn:errorEventDefinition id="ErrorEventDefinition_Form_CardValidationFailed" errorRef="Error_ValidationFailed" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_Form_SelectSeatValidationFailed" name="Ошибка формы" attachedToRef="Task_Client_SelectSeat">
      <bpmn:outgoing>Flow_Form_SelectSeatValidationFailed</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_Form_SelectSeatValidationFailed" errorRef="Error_ValidationFailed" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_Form_PassengerValidationFailed" name="Ошибка формы" attachedToRef="Task_Client_EnterPassenger">
