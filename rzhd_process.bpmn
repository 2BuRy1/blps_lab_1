        <bpmn:flowNodeRef>Event_1b8m8lu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Form_ServiceRequestValidationFailed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Client_RoleClient" name="ROLE: CLIENT">
        <bpmn:flowNodeRef>Activity_1t60bjg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_113p513</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_0hixtyb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Client</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Client_EnterCard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Client_SendSearchRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Client_SelectSeat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Client_EnterPassenger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Client_EnterRoute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Client_ReceiveTicket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Client_Success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Client_ConfirmOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Client_StartServerOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_0nq613n</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_1tp4110</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Client_RetryAuth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Client_Register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_05s562c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Client_Login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Client_AuthFailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Client_OrderValidationFailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Client_RequestServerPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Client_PreparePaymentPath</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Client_Expected3DS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Client_SyncServerOrderState</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Client_PaymentResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Client_PaymentValidationFailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Client_Confirm3DS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Client_ConfirmServer3DS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Client_3dsValidationFailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Form_CardValidationFailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Form_SelectSeatValidationFailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Form_PassengerValidationFailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Form_RouteValidationFailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Form_ConfirmOrderValidationFailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Form_RegisterValidationFailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Form_LoginValidationFailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Form_Client3dsValidationFailed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:sequenceFlow id="Flow_1srb6m2" sourceRef="Task_Client_StartServerOrder" targetRef="Task_Client_EnterCard" />
    <bpmn:sequenceFlow id="Flow_0a4sdce" sourceRef="Task_Client_SyncServerOrderState" targetRef="Gateway_Client_PaymentResult" />
    <bpmn:serviceTask id="Task_Client_PreparePaymentPath" name="Определить клиентский путь оплаты" camunda:delegateExpression="${prepareClientPaymentPathDelegate}">
      <bpmn:incoming>Flow_C_12</bpmn:incoming>
      <bpmn:outgoing>Flow_C_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Client_Expected3DS" name="Ожидается 3DS" default="Flow_C_19">
      <bpmn:incoming>Flow_C_17</bpmn:incoming>
      <bpmn:outgoing>Flow_C_18</bpmn:outgoing>
      <bpmn:outgoing>Flow_C_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Client_SyncServerOrderState" name="Получить результат оплаты с сервера" camunda:delegateExpression="${syncClientOrderStateDelegate}">
      <bpmn:incoming>Flow_C_19</bpmn:incoming>
      <bpmn:incoming>Flow_C_10</bpmn:incoming>
      <bpmn:outgoing>Flow_0a4sdce</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Client_PaymentResult" name="Результат оплаты" default="Flow_C_15">
      <bpmn:incoming>Flow_0a4sdce</bpmn:incoming>
      <bpmn:outgoing>Flow_C_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_C_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_C_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Client_StartServerOrder" name="Создать заказ на сервере" camunda:delegateExpression="${startServerOrderFromClientDelegate}">
      <bpmn:incoming>Flow_C_8</bpmn:incoming>
      <bpmn:outgoing>Flow_1srb6m2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_C_8" sourceRef="Task_Client_ConfirmOrder" targetRef="Task_Client_StartServerOrder" />
    <bpmn:sequenceFlow id="Flow_C_10" sourceRef="Task_Client_ConfirmServer3DS" targetRef="Task_Client_SyncServerOrderState" />
    <bpmn:sequenceFlow id="Flow_C_9" sourceRef="Task_Client_EnterCard" targetRef="Task_Client_RequestServerPayment" />
    <bpmn:sequenceFlow id="Flow_C_12" sourceRef="Task_Client_RequestServerPayment" targetRef="Task_Client_PreparePaymentPath" />
    <bpmn:sequenceFlow id="Flow_C_17" sourceRef="Task_Client_PreparePaymentPath" targetRef="Gateway_Client_Expected3DS" />
    <bpmn:sequenceFlow id="Flow_C_18" sourceRef="Gateway_Client_Expected3DS" targetRef="Task_Client_Confirm3DS">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${clientPredicted3ds == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_C_19" sourceRef="Gateway_Client_Expected3DS" targetRef="Task_Client_SyncServerOrderState" />
    <bpmn:sequenceFlow id="Flow_C_13" sourceRef="Gateway_Client_PaymentResult" targetRef="Task_Client_Confirm3DS">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${clientOrderState == 'PENDING_3DS'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_C_14" sourceRef="Gateway_Client_PaymentResult" targetRef="Task_Client_ReceiveTicket">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${clientOrderState == 'PAID'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_C_15" sourceRef="Gateway_Client_PaymentResult" targetRef="Activity_0nq613n" />
    <bpmn:sequenceFlow id="Flow_C_11" sourceRef="Task_Client_Confirm3DS" targetRef="Task_Client_ConfirmServer3DS" />
    <bpmn:sequenceFlow id="Flow_Client_OrderValidationFailed" sourceRef="Boundary_Client_OrderValidationFailed" targetRef="Task_Client_EnterRoute" />
    <bpmn:sequenceFlow id="Flow_Client_PaymentValidationFailed" sourceRef="Boundary_Client_PaymentValidationFailed" targetRef="Task_Client_EnterCard" />
    <bpmn:sequenceFlow id="Flow_Client_3dsValidationFailed" sourceRef="Boundary_Client_3dsValidationFailed" targetRef="Task_Client_Confirm3DS" />
    <bpmn:sequenceFlow id="Flow_C_16" sourceRef="Activity_0nq613n" targetRef="Event_1tp4110" />
    <bpmn:task id="Activity_1t60bjg" name="Открыть форму логина">
      <bpmn:incoming>Flow_0heq6fs</bpmn:incoming>
      <bpmn:outgoing>Flow_1i76m3y</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_113p513" name="Открыть форму регистрации">
      <bpmn:incoming>Flow_0ob46qo</bpmn:incoming>
      <bpmn:outgoing>Flow_0457zw5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_0hixtyb" name="Пользователь зарегистрирован" default="Flow_0ob46qo">
      <bpmn:outgoing>Flow_0heq6fs</bpmn:outgoing>
      <bpmn:outgoing>Flow_0ob46qo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:startEvent id="Start_Client" name="Сайт открыт" camunda:candidateStarterGroups="client">
      <bpmn:outgoing>Flow_1bbd437</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Operator_SubmitServiceRequest" name="Отправить служебный запрос" camunda:formKey="camunda-forms:app:forms/service-request.form" camunda:candidateGroups="operator,admin">
      <bpmn:extensionElements>
        <camunda:taskListener delegateExpression="${formDataValidator}" event="complete" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_01l4rji</bpmn:incoming>
      <bpmn:incoming>Flow_Form_ServiceRequestValidationFailed</bpmn:incoming>
      <bpmn:outgoing>Flow_0cgii46</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Client_DispatchServiceRequest" name="Запустить служебный процесс" camunda:delegateExpression="${dispatchServiceRequestDelegate}">
      <bpmn:incoming>Flow_0cgii46</bpmn:incoming>
      <bpmn:outgoing>Flow_Client_ServiceRequestEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_Client_EnterCard" name="Ввести данные карты" camunda:formKey="camunda-forms:app:forms/client-card.form" camunda:candidateGroups="client">
      <bpmn:extensionElements>
        <camunda:taskListener delegateExpression="${formDataValidator}" event="complete" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1srb6m2</bpmn:incoming>
      <bpmn:incoming>Flow_Client_PaymentValidationFailed</bpmn:incoming>
      <bpmn:incoming>Flow_Form_CardValidationFailed</bpmn:incoming>
      <bpmn:outgoing>Flow_C_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Task_Client_SendSearchRequest" name="Отправить запрос на поиск">
      <bpmn:incoming>Flow_C_3</bpmn:incoming>
      <bpmn:outgoing>Flow_C_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Task_Client_SelectSeat" name="Выбрать поезд, вагон и место" camunda:formKey="camunda-forms:app:forms/client-select-seat.form" camunda:candidateGroups="client">
      <bpmn:extensionElements>
        <camunda:taskListener delegateExpression="${formDataValidator}" event="complete" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_C_5</bpmn:incoming>
      <bpmn:incoming>Flow_Form_SelectSeatValidationFailed</bpmn:incoming>
      <bpmn:outgoing>Flow_C_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Client_EnterPassenger" name="Ввести данные пассажира(email, телефон, паспорт)" camunda:formKey="camunda-forms:app:forms/client-passenger.form" camunda:candidateGroups="client">
      <bpmn:extensionElements>
        <camunda:taskListener delegateExpression="${formDataValidator}" event="complete" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_C_7</bpmn:incoming>
      <bpmn:incoming>Flow_Form_PassengerValidationFailed</bpmn:incoming>
      <bpmn:outgoing>Flow_16vkgsf</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Client_EnterRoute" name="Ввести маршрут, дату и пассажиров" camunda:formKey="camunda-forms:app:forms/client-search.form" camunda:candidateGroups="client">
      <bpmn:extensionElements>
        <camunda:taskListener delegateExpression="${formDataValidator}" event="complete" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1bbd437</bpmn:incoming>
      <bpmn:incoming>Flow_061vcsb</bpmn:incoming>
      <bpmn:incoming>Flow_Client_OrderValidationFailed</bpmn:incoming>
      <bpmn:incoming>Flow_Form_RouteValidationFailed</bpmn:incoming>
      <bpmn:outgoing>Flow_C_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Task_Client_ReceiveTicket" name="Получить электронный билет">
