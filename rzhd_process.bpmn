        <bpmn:outgoing>Flow_Transaction_EndPending3dsTtl</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="End_Server_Pending3dsTtl">
        <bpmn:incoming>Flow_Transaction_EndPending3dsTtl</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="Task_Server_IssueTicket" name="Сформировать электронный билет" camunda:delegateExpression="${issueTicketDelegate}">
        <bpmn:incoming>Flow_1n58psq</bpmn:incoming>
        <bpmn:incoming>Flow_Transaction_IssueAfter3ds</bpmn:incoming>
        <bpmn:outgoing>Flow_Transaction_Commit</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="DataOutputAssociation_088quaf">
          <bpmn:targetRef>DataStoreRef_Main</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_Server_UpdatePaymentStatusDB" name="Подтвердить 3DS в банке" camunda:asyncBefore="true" camunda:delegateExpression="${confirm3dsDelegate}">
        <bpmn:incoming>Flow_Transaction_Confirm3dsDispatch</bpmn:incoming>
        <bpmn:outgoing>Flow_1vkzlvl</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="DataOutputAssociation_1nniwny">
          <bpmn:targetRef>DataStoreRef_Main</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
      </bpmn:serviceTask>
      <bpmn:eventBasedGateway id="Gateway_Server_FinalBankDecision">
        <bpmn:incoming>Flow_1vkzlvl</bpmn:incoming>
        <bpmn:outgoing>Flow_Transaction_FinalSuccessCatch</bpmn:outgoing>
        <bpmn:outgoing>Flow_Transaction_FinalDeclinedCatch</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="Catch_Server_FinalSuccess" name="Принять SUCCESS">
        <bpmn:incoming>Flow_Transaction_FinalSuccessCatch</bpmn:incoming>
        <bpmn:outgoing>Flow_Transaction_IssueAfter3ds</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Message_BankSuccess" />
      </bpmn:intermediateCatchEvent>
      <bpmn:intermediateCatchEvent id="Catch_Server_FinalDeclined" name="Принять DECLINED">
        <bpmn:incoming>Flow_Transaction_FinalDeclinedCatch</bpmn:incoming>
        <bpmn:outgoing>Flow_Transaction_CancelAfter3ds</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Message_BankDeclined" />
      </bpmn:intermediateCatchEvent>
      <bpmn:sequenceFlow id="Flow_Transaction_StartDecision" sourceRef="Start_Transaction_OrderPayment" targetRef="Gateway_0ipe0f6" />
      <bpmn:sequenceFlow id="Flow_1n58psq" sourceRef="Gateway_0ipe0f6" targetRef="Task_Server_IssueTicket">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bankStatus == 'SUCCESS'}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_Transaction_Wait3dsConfirm" sourceRef="Gateway_0ipe0f6" targetRef="Task_Server_Confirm3DSWithBank">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bankStatus == 'REQUIRES_3DS'}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_Form_Server3dsValidationFailed" sourceRef="Boundary_Form_Server3dsValidationFailed" targetRef="Task_Server_Confirm3DSWithBank" />
      <bpmn:sequenceFlow id="Flow_Transaction_Confirm3dsDispatch" sourceRef="Task_Server_Confirm3DSWithBank" targetRef="Task_Server_UpdatePaymentStatusDB" />
      <bpmn:sequenceFlow id="Flow_1vkzlvl" sourceRef="Task_Server_UpdatePaymentStatusDB" targetRef="Gateway_Server_FinalBankDecision" />
