    <bpmn:endEvent id="Event_1b8m8lu" name="Конец">
      <bpmn:incoming>Flow_Client_ServiceRequestEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_Client_RetryAuth" name="Повторить ввод" default="Flow_Client_RetryRegistration">
      <bpmn:incoming>Flow_Client_AuthFailedToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Client_RetryLogin</bpmn:outgoing>
      <bpmn:outgoing>Flow_Client_RetryRegistration</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Client_Register" name="Ввести данные для регистрации (логин, пароль)" camunda:formKey="camunda-forms:app:forms/client-register.form" camunda:candidateGroups="client">
