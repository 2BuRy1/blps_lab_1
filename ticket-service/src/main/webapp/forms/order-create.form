{
  "id": "order-create",
  "type": "default",
  "schemaVersion": 12,
  "components": [
    {
      "label": "Validation error",
      "type": "html",
      "content": "<div style=\"position: fixed; right: 24px; bottom: 24px; max-width: 360px; padding: 12px; border-radius: 6px; background: red; color: white; white-space: normal;\">{{validationError}}</div>",
      "conditional": {
        "hide": "=validationError = null or validationError = \"\""
      }
    },
    {
      "label": "Route ID",
      "type": "textfield",
      "key": "routeId",
      "validate": {
        "required": true
      }
    },
    {
      "label": "Seat",
      "type": "textfield",
      "key": "seat",
      "validate": {
        "required": true,
        "pattern": "^[0-9]{1,2}[A-Z]$"
      }
    },
    {
      "label": "Passenger Passport ID",
      "type": "textfield",
      "key": "passengerPassportId",
      "validate": {
        "required": true,
        "pattern": "^\\d{4}\\s?\\d{6}$"
      }
    },
    {
      "label": "Passenger Full Name",
      "type": "textfield",
      "key": "passengerFullName",
      "validate": {
        "required": true,
        "maxLength": 255
      }
    }
  ]
}
