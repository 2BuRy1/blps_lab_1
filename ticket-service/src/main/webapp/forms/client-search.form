{
  "id": "client-search",
  "type": "default",
  "schemaVersion": 12,
  "components": [
    {
      "label": "Validation error",
      "type": "html",
      "content": "<div style=\"position: fixed; right: 24px; bottom: 24px; max-width: 360px; padding: 12px; border-radius: 6px; background: red; color: white; white-space: normal;\">{{validationError}}</div>",
      "conditional": {
        "hide": "=validationError = null or validationError = \"\""
      }
    },
    {
      "label": "From",
      "type": "textfield",
      "key": "from",
      "defaultValue": "MSK",
      "validate": {}
    },
    {
      "label": "To",
      "type": "textfield",
      "key": "to",
      "defaultValue": "SPB",
      "validate": {}
    },
    {
      "label": "Travel Date",
      "type": "textfield",
      "key": "travelDate",
      "defaultValue": "2026-04-01",
      "validate": {
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      }
    }
  ]
}
